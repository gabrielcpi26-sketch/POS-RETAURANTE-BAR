datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}
model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Area {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean  @default(true) // 👈 CAMPO QUE FALTABA
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tables      Table[]
}

model Table {
  id        Int      @id @default(autoincrement())
  name      String
  number    Int?        // ← número de mesa (opcional)
  capacity  Int      @default(4)
  areaId    Int
  area      Area     @relation(fields: [areaId], references: [id])
  isActive  Boolean  @default(true)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Order {
  id        Int      @id @default(autoincrement())
  table     Table    @relation(fields: [tableId], references: [id])
  tableId   Int

  // Guardamos los productos como JSON en un String
  items     String

  total     Float    @default(0)
  createdAt DateTime @default(now())
  paymentMethod String? @default("CASH") // CASH | CARD | TRANSFER
  paymentRef    String?
 isPaid   Boolean  @default(false)
  paidAt   DateTime?

}

model DailyReport {
  id              Int      @id @default(autoincrement())

  date            DateTime
  tenantId        Int

  totalOrders     Int
  totalSales      Float

  paymentCash     Float    @default(0)
  paymentCard     Float    @default(0)
  paymentTransfer Float    @default(0)

  createdAt       DateTime @default(now())

  grossSales      Float    @default(0)
  cancelledSales  Float    @default(0)
  netSales        Float    @default(0)

  @@unique([date, tenantId], name: "date_tenantId")
}

model InventoryItem {
  id           Int                 @id @default(autoincrement())
  name         String
  sku          String?             @unique
  unit         String?
  currentStock Int                 @default(0)
isActive     Boolean  @default(true) // 👈 BORRADO SEGURO
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  movements        InventoryMovement[]

}

model InventoryMovement {
  id        Int           @id @default(autoincrement())
  item      InventoryItem @relation(fields: [itemId], references: [id])
  itemId    Int
  type      String        // "IN" | "OUT"
  quantity  Int
  reason    String?
  reference String?
  createdAt DateTime      @default(now())
}

model MenuRecipe {
  id          Int                    @id @default(autoincrement())
  menuName    String                 @unique   // nombre como aparece en el POS (ej. "Cerveza nacional")
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  
}

	
